PORT=5000
NODE_ENV=development

# JWT Secret (ganti dengan string random yang kuat untuk production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection
# Option 1: Use connection string (recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diagnosa_hp

# Option 2: Use individual parameters (if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=diagnosa_hp
# DB_USER=postgres
# DB_PASSWORD=postgres

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin Default (untuk seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrator
