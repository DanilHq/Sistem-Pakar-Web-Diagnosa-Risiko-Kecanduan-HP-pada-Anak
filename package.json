{
  "name": "sistem-pakar-diagnosa-kecanduan-hp",
  "version": "1.0.0",
  "description": "Sistem Pakar untuk Diagnosa Risiko Kecanduan HP pada Anak",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "setup": "cd backend && npm run migrate && npm run seed",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview"
  },
  "keywords": [
    "expert-system",
    "forward-chaining",
    "diagnosis",
    "health",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanilHq/Sistem-Pakar-Web-Diagnosa-Risiko-Kecanduan-HP-pada-Anak.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DanilHq/Sistem-Pakar-Web-Diagnosa-Risiko-Kecanduan-HP-pada-Anak/issues"
  },
  "homepage": "https://github.com/DanilHq/Sistem-Pakar-Web-Diagnosa-Risiko-Kecanduan-HP-pada-Anak#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
